{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "incremental": false
  },
  "include": ["src/server/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", ".next", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
